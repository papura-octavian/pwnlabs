{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "pwnlabs-api",
    "Audience": "pwnlabs-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Labs": {
    "DefaultImage": "nginx:alpine",
    "ContainerPort": 80,
    "MemoryLimitMb": 128,
    "LifetimeMinutes": 60,
    "MaxActiveLabsPerUser": 1
  }
}
