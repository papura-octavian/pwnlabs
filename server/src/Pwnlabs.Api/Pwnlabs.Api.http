@baseurl = https://localhost:7173

### Health check
# Expected: 200 Healthy
GET {{baseurl}}/health

### Register a valid user
# Expected: 201 Created, no password/passwordHash in body
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "alice",
  "email": "alice@example.com",
  "password": "CorrectHorse123"
}

### Same email, different letter case
# Expected: 409 Conflict
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "alice2",
  "email": "ALICE@Example.com",
  "password": "CorrectHorse123"
}

### Same username
# Expected: 409 Conflict
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "alice",
  "email": "other@example.com",
  "password": "CorrectHorse123"
}

### Invalid data
# Expected: 400, errors for username, email and password
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "a",
  "email": "not-an-email",
  "password": "short"
}

### Same username, different letter case
# Expected: 409, Username is already taken
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "ALICE",
  "email": "alice-upper@example.com",
  "password": "CorrectHorse123"
}

### Login
# @name login
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "CorrectHorse123"
}

### Login with wrong password
# Expected: 401
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "WrongPassword123"
}

### Me with token
# Expected: 200 with your data
GET {{baseurl}}/api/v1/users/me
Authorization: Bearer {{login.response.body.accessToken}}

### Me without token
# Expected: 401
GET {{baseurl}}/api/v1/users/me

### Login (sets the refresh cookie)
# @name login
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "CorrectHorse123"
}

### Refresh (REST Client sends the cookie automatically)
POST {{baseurl}}/api/v1/auth/refresh

### Logout
POST {{baseurl}}/api/v1/auth/logout

### Refresh after logout
# Expected: 401
POST {{baseurl}}/api/v1/auth/refresh

### Reuse test: login
# @name reuse
# @no-cookie-jar
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "CorrectHorse123"
}

### Reuse test: first refresh with the stolen token
# Expected: 200
# @no-cookie-jar
POST {{baseurl}}/api/v1/auth/refresh
Cookie: refreshToken=D0F24F8EDCDF5E9E80CA1BD6B412AC4D12C4AB03AD0396AD04030858BECB76E7DD72719F0C8B95DC8BF64446E426906D5150D8686C60DEF094BF4ABDEFFC0B7E

### Reuse test: same token again
# Expected: 401, and ALL of alice's tokens get revoked
# @no-cookie-jar
POST {{baseurl}}/api/v1/auth/refresh
Cookie: refreshToken=D0F24F8EDCDF5E9E80CA1BD6B412AC4D12C4AB03AD0396AD04030858BECB76E7DD72719F0C8B95DC8BF64446E426906D5150D8686C60DEF094BF4ABDEFFC0B7E

### Login
# @name login
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "alice@example.com",
  "password": "CorrectHorse123"
}

### Start a lab
# @name startLab
POST {{baseurl}}/api/v1/labs
Authorization: Bearer {{login.response.body.accessToken}}

### My labs
GET {{baseurl}}/api/v1/labs
Authorization: Bearer {{login.response.body.accessToken}}

### Start a second lab
# Expected: 409
POST {{baseurl}}/api/v1/labs
Authorization: Bearer {{login.response.body.accessToken}}

### Stop the lab
DELETE {{baseurl}}/api/v1/labs/{{startLab.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### REGISTER evilTwin
POST {{baseurl}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "evilTwin",
  "email": "elivTwin@example.com",
  "password": "CorrectHorse123"
}

### Login as evilTwin
# @name loginEvil
POST {{baseurl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "elivTwin@example.com",
  "password": "CorrectHorse123"
}

### evilTwin starts a lab
# @name startLabEvil
POST {{baseurl}}/api/v1/labs
Authorization: Bearer {{loginEvil.response.body.accessToken}}

### evilTwin's labs
GET {{baseurl}}/api/v1/labs
Authorization: Bearer {{loginEvil.response.body.accessToken}}

### Stop the lab
DELETE {{baseurl}}/api/v1/labs/{{startLab.response.body.id}}
Authorization: Bearer {{login.response.body.accessToken}}

### Stop lab 01a1db90
DELETE {{baseurl}}/api/v1/labs/01a1db90-887e-7965-97e2-73a5094be1c2
Authorization: Bearer {{loginEvil.response.body.accessToken}}